# PhotoAssistant — environment template.
#
#   cp .env.example .env
#
# .env is git-ignored and holds real values; this file is tracked and holds
# placeholders only. Every new variable must be added here in the same commit
# that introduces it.
#
# Values are primitives. Composed values that differ between the host and the
# container network (connection strings, service URLs) are assembled where they
# are used: infra/docker-compose.yml passes container-side values to services,
# while local runs use the *_LOCAL entries below.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=photoassistant
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=photoassistant

# Host port the container publishes on. Deliberately not 5432: a locally
# installed PostgreSQL service takes that port first and the connection then
# silently reaches the wrong server, which shows up as an authentication
# failure rather than as a conflict. Inside the compose network the port is
# always 5432 — this value only affects access from the host.
POSTGRES_PORT=5433

# Used when running the backend on the host against the container database.
# Inside the compose network the host is `postgres`, not `localhost`.
POSTGRES_HOST_LOCAL=localhost

# ---------------------------------------------------------------------------
# MinIO / S3
# ---------------------------------------------------------------------------
# MINIO_ROOT_PASSWORD must be at least 8 characters or the server refuses to start.
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me-min-8-chars
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Bucket layout: uploads, generated derivatives (pre512, proxy2048, after512),
# and rendered full-resolution exports.
S3_BUCKET_ORIGINALS=originals
S3_BUCKET_DERIVATIVES=derivatives
S3_BUCKET_EXPORTS=exports

# Endpoint as seen from the host. Inside the compose network it is http://minio:9000.
S3_ENDPOINT_LOCAL=http://localhost:9000

# ---------------------------------------------------------------------------
# Backend (.NET API)
# ---------------------------------------------------------------------------
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Signing key for JWT access tokens. Generate a fresh one, do not reuse:
#   openssl rand -base64 48
JWT_KEY=replace-me-with-a-long-random-value
JWT_ISSUER=photoassistant
JWT_AUDIENCE=photoassistant
JWT_EXPIRY_MINUTES=60

# ---------------------------------------------------------------------------
# ML service (FastAPI, internal — never exposed to the browser)
# ---------------------------------------------------------------------------
ML_PORT=8000
ML_SERVICE_URL_LOCAL=http://localhost:8000

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
FRONTEND_PORT=4200

# ---------------------------------------------------------------------------
# Offline pipeline (phase 2)
# ---------------------------------------------------------------------------
# Absolute path to the read-only FiveK dataset. The pipeline never writes here.
FIVEK_DATASET_PATH=D:/path/to/Dataset/fivek_dataset
