# PhotoAssistant — environment template.
#
#   cp .env.example .env
#
# .env is git-ignored and holds real values; this file is tracked and holds
# placeholders only. Every new variable must be added here in the same commit
# that introduces it.
#
# Values are primitives. Composed values that differ between the host and the
# container network (connection strings, service URLs) are assembled where they
# are used: infra/docker-compose.yml passes container-side values to services,
# while local runs use the *_LOCAL entries below.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=photoassistant
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=photoassistant

# Host port the container publishes on. Deliberately not 5432: a locally
# installed PostgreSQL service takes that port first and the connection then
# silently reaches the wrong server, which shows up as an authentication
# failure rather than as a conflict. Inside the compose network the port is
# always 5432 — this value only affects access from the host.
POSTGRES_PORT=5433

# Used when running the backend on the host against the container database.
# Inside the compose network the host is `postgres`, not `localhost`.
POSTGRES_HOST_LOCAL=localhost

# ---------------------------------------------------------------------------
# MinIO / S3
# ---------------------------------------------------------------------------
# MINIO_ROOT_PASSWORD must be at least 8 characters or the server refuses to start.
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me-min-8-chars
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Bucket layout: uploads, generated derivatives (pre512, proxy2048, after512),
# and rendered full-resolution exports.
S3_BUCKET_ORIGINALS=originals
S3_BUCKET_DERIVATIVES=derivatives
S3_BUCKET_EXPORTS=exports

# Endpoint as seen from the host. Inside the compose network it is http://minio:9000.
S3_ENDPOINT_LOCAL=http://localhost:9000

# The library reads neutral S3 names (S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY)
# so that no code mentions MinIO. Compose sets them for the containers; on the
# host, pipeline/environment.py maps S3_ENDPOINT_LOCAL and the MINIO_ROOT_*
# credentials onto them. Set them here only to point a run at something else.
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Signing region. S3 requires one even where the concept does not apply; MinIO
# accepts anything. Only set this against a provider that cares.
# S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Backend (.NET API)
# ---------------------------------------------------------------------------
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Whether the api applies pending migrations when it starts. docker compose sets
# this to true so the stack comes up from a clean state with no manual step; it
# stays off elsewhere, because with more than one instance the migrations would
# race. Not read outside compose — see DatabaseMigrator.
# APPLY_MIGRATIONS_ON_STARTUP=false

# Signing key for JWT access tokens. Generate a fresh one, do not reuse:
#   openssl rand -base64 48
JWT_KEY=replace-me-with-a-long-random-value
JWT_ISSUER=photoassistant
JWT_AUDIENCE=photoassistant
JWT_EXPIRY_MINUTES=60

# ---------------------------------------------------------------------------
# ML service (FastAPI, internal — never exposed to the browser)
# ---------------------------------------------------------------------------
ML_PORT=8000
ML_SERVICE_URL_LOCAL=http://localhost:8000

# Reported by the ML service health endpoint, so it is obvious which instance
# answered. Read by service/settings.py.
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
FRONTEND_PORT=4200

# ---------------------------------------------------------------------------
# Offline pipeline (phase 2)
# ---------------------------------------------------------------------------
# Absolute path to the read-only FiveK dataset. The pipeline never writes here.
FIVEK_DATASET_PATH=D:/path/to/Dataset/fivek_dataset

# Scratch space for the phase 1b feasibility probe: downloaded expert renditions
# and the 512px derivatives made from them. Git-ignored, safe to delete — every
# file in it can be produced again by pipeline/probe/.
# Defaults to pipeline/.work when unset; set it if that disk is short of the
# ~8 GB the 100-photograph sample needs.
# PROBE_WORK_DIR=D:/path/to/probe-work

# Scratch space for the phase 2 ingest. Holds one downloaded rendition per worker
# at a time and nothing else: the fetch step derives from a file and deletes it
# before moving on, so this never grows past a few hundred megabytes even though
# roughly 1.58 TB passes through it.
# Defaults to pipeline/.work/ingest when unset.
# INGEST_WORK_DIR=D:/path/to/ingest-work

# How many renditions are downloaded at once. Measured 2026-08-28 against
# data.csail.mit.edu: 14.9 MB/s sequential, 50.9 MB/s at six connections, and
# per-connection throughput falling from 14.9 to 8.5 along the way. Six is the
# measured working point. Raising it is not a free win — the server is MIT's and
# shares this dataset as a courtesy (.claude/rules/pipeline.md).
# INGEST_DOWNLOAD_WORKERS=6

# How many processes turn downloaded renditions into derivatives. Measured at
# 1.08 s per file against roughly one arriving file per second, so a single
# worker does not keep up and the network stops being the limit. Defaults to
# half the cores.
# INGEST_DERIVE_WORKERS=4

# --- CLIP embeddings (phase 2, task 8) ---------------------------------------
# All four have working defaults; they exist so that the encoder can be changed
# without touching code, not because anything has to be set.

# Architecture and trained weights. ViT-B/32 outputs 512 numbers whichever
# weights it carries, so photos.clip_embedding stays vector(512) and swapping
# these is one name plus a recomputation of 5.000 photographs — minutes.
# Alternatives for this architecture: openai, laion400m_e32, datacomp_xl_s13b_b90k.
# CLIP_MODEL=ViT-B-32
# CLIP_PRETRAINED=laion2b_s34b_b79k

# Where the encoder runs. CPU is the measured default: the job is one-off, and
# the projection from a 64-image measurement decides whether a GPU setup is worth
# building at all (docs/notes/phase-2-concepts.md §B48).
# CLIP_DEVICE=cpu

# Images per forward pass, and an optional cap on torch's thread pool. The cap is
# for running the embedding pass alongside something else that is already using
# the cores; left at 0, torch sizes its own pool.
# CLIP_BATCH_SIZE=32
# CLIP_THREADS=0
