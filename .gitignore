# ---------------------------------------------------------------------------
# Dataset — MIT-Adobe FiveK, ~50 GB on local disk. NEVER commit this.
# The pipeline treats it as read-only input; nothing here belongs in the repo.
# ---------------------------------------------------------------------------
Dataset/

# --- Secrets and local configuration ---------------------------------------
# .env holds real credentials; .env.example is the documented template and
# must stay tracked (see the negation below).
.env
.env.*
!.env.example

# --- Python -----------------------------------------------------------------
# Scratch space for the phase 1b probe: downloaded expert TIFFs and the 512px
# derivatives. Reproducible from pipeline/probe/, and several gigabytes.
pipeline/.work/

.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- .NET -------------------------------------------------------------------
bin/
obj/
*.user
*.suo
*.userprefs
TestResults/
[Bb]uild[Ll]og.*

# --- Node / Angular ---------------------------------------------------------
node_modules/
dist/
.angular/
*.tsbuildinfo
coverage/

# --- Editors and tooling ----------------------------------------------------
.vs/
.idea/
*.swp

# --- Operating system -------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# --- Golden test output -----------------------------------------------------
# What the browser renders for the golden agreement test. Regenerated by
# `npm --prefix frontend run golden`, and deliberately not committed: a stored
# copy would let the Python side compare against an old shader and still pass.
# The comparison has to be between the two implementations as they are now.
ml/tests/golden/rendered/
